# Jira integration (optional — leave blank to disable webhook auto-analysis)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
# Jira Cloud does not sign webhook payloads — leave empty
JIRA_WEBHOOK_SECRET=

# Git — personal access tokens for cloning private repos (optional)
GITHUB_TOKEN=
GITLAB_TOKEN=
# Comma-separated list of repos to clone + index on startup
REPO_URLS=

# LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TEMPERATURE=0.1
OLLAMA_CONTEXT_WINDOW=8192

# Storage (relative to project root)
INDEX_DIR=data/indexes
REPOS_DIR=data/repos
LOGS_DIR=data/logs

# Indexing
MAX_CONTEXT_FILES=10
CHUNK_SIZE=120

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
